# Local Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
build/
dist/

# Credentials: only the reviewed, blank template is shareable
.env
.env.*
!.env.example
*.pem
*.key

# Application storage (contains profiles, resumes, history, and browser state)
/data/
/exports/
/local/
/.privacy-audit/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Logs, failure captures, generated reports and test artifacts
logs/
*.log
/failures/
/screenshots/
/reports/
/test-results/
/playwright-report/
/htmlcov/
.coverage
.coverage.*
coverage.xml
*.tmp
*.temp
*.bak
*.xlsx
*.xls
/resumes/
/resume*.pdf
/resume*.docx

# Root-level browser/session exports; do not hide source session modules
/browser_data/
/browser_profile/
/user_data/
/profiles/
/playwright/.auth/
/cookies*
/session*
/storage_state*
# Session exports may also be placed beneath test/tool directories
cookies*.json
cookies*.txt
session*.json
storage_state*.json

# Raw local job/profile captures. Reviewed synthetic JSON lives in tests/fixtures/.
/tests/*.json

# Machine-specific shortcuts, editor settings, and OS metadata
*.lnk
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
