# Blank reference only. The application reads process environment variables;
# it does not automatically load .env files. Set only the variables you need.
# Leave optional variables unset to preserve application defaults.

# Private storage locations (default to ./data and ./exports)
# JOB_APPLIER_DATA_DIR=
# JOB_APPLIER_EXPORTS_DIR=

# Optional AI provider configuration
# LLM_PROVIDER=
# LLM_ENABLED=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=
# LLM_API_KEY=
# OPENAI_API_KEY=
